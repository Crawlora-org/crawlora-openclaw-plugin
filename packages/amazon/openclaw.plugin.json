{
  "id": "crawlora-amazon",
  "name": "Amazon by Crawlora",
  "description": "Amazon product search and product details through Crawlora.",
  "version": "1.0.1",
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Crawlora API key. Falls back to the CRAWLORA_API_KEY environment variable."
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "crawlora_amazon_search",
      "crawlora_amazon_product"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "apiKey",
          "expected": "string"
        }
      ]
    }
  }
}
