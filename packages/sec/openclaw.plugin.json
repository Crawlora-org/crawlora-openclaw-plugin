{
  "id": "crawlora-sec",
  "name": "SEC EDGAR by Crawlora",
  "description": "SEC EDGAR company research, financial statements, filings, and insider transactions through Crawlora.",
  "version": "1.0.1",
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Crawlora API key. Falls back to the CRAWLORA_API_KEY environment variable."
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "crawlora_sec_company_search",
      "crawlora_sec_company_intelligence",
      "crawlora_sec_financials",
      "crawlora_sec_filings",
      "crawlora_sec_filing_sections",
      "crawlora_sec_full_text_search",
      "crawlora_sec_insider"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "apiKey",
          "expected": "string"
        }
      ]
    }
  }
}
