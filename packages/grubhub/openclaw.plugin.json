{
  "id": "crawlora-grubhub",
  "name": "Grubhub by Crawlora",
  "description": "Public Grubhub data through Crawlora.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Crawlora API key. Falls back to the CRAWLORA_API_KEY environment variable."
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "crawlora_grubhub_restaurant"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "apiKey",
          "expected": "string"
        }
      ]
    }
  }
}
