{
  "name": "@crawlora-org/openclaw-plugin",
  "version": "1.0.0",
  "description": "Crawlora tools for OpenClaw: live structured web search, products, maps, transcripts, finance, and company research.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crawlora-org/crawlora-openclaw-plugin.git"
  },
  "homepage": "https://github.com/Crawlora-org/crawlora-openclaw-plugin#readme",
  "bugs": {
    "url": "https://github.com/Crawlora-org/crawlora-openclaw-plugin/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js && node scripts/manifest.mjs",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run plugin:build",
    "test:live": "npm run build && node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@crawlora-org/sdk": "1.41.0-sdk.1",
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "openclaw": "2026.9.3",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0"
  },
  "peerDependencies": {
    "openclaw": "2026.9.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.9.3",
      "minGatewayVersion": "2026.9.3"
    },
    "build": {
      "openclawVersion": "2026.9.3",
      "pluginSdkVersion": "2026.9.3"
    }
  }
}
