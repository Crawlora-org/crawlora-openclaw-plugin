{
  "id": "crawlora",
  "name": "Crawlora",
  "description": "Live, structured web data — search engines, marketplaces, finance, maps, media, and trends.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Crawlora API key. Falls back to the CRAWLORA_API_KEY environment variable."
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "categories": [
    "web"
  ],
  "uiHints": {
    "apiKey": {
      "label": "Crawlora API key",
      "sensitive": true,
      "help": "Use plugin config or CRAWLORA_API_KEY from the Gateway environment."
    }
  },
  "contracts": {
    "tools": [
      "crawlora_google_search",
      "crawlora_google_news",
      "crawlora_google_videos",
      "crawlora_bing_search",
      "crawlora_amazon_search",
      "crawlora_amazon_product",
      "crawlora_ebay_search",
      "crawlora_youtube_transcript",
      "crawlora_yahoo_finance_ticker_quote",
      "crawlora_sec_company_search",
      "crawlora_sec_company_intelligence",
      "crawlora_sec_financials",
      "crawlora_sec_filings",
      "crawlora_sec_filing_sections",
      "crawlora_sec_full_text_search",
      "crawlora_sec_insider",
      "crawlora_jobs_hiring_signals",
      "crawlora_jobs_company_search",
      "crawlora_jobs_greenhouse_board",
      "crawlora_jobs_lever_postings",
      "crawlora_jobs_ashby_board",
      "crawlora_google_trends_explore",
      "crawlora_google_map_search"
    ]
  }
}
